<Window x:Class="PS4wpfDumper.RuntimeInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plutana-DMP | Runtime Inspector" Height="560" Width="900"
        MinHeight="420" MinWidth="720" WindowStartupLocation="CenterOwner"
        Background="#FF171717" Foreground="#FFF2F2F2">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="RUNTIME INSPECTOR" FontSize="20" FontWeight="Bold" Foreground="#FFFF8A24"/>
            <TextBlock Text="Read-only receiver for module/address records from an authorized offline PS4 inspector." Foreground="#FFBDBDBD" Margin="0,4,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Listen port" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="portTextBox" Text="9147" Width="80" Padding="6" Margin="0,0,10,0" Background="#FF292929" Foreground="White" BorderBrush="#FF555555"/>
            <Button x:Name="listenButton" Content="Start listener" Width="115" Padding="8,5" Click="listenButton_Click" Background="#FFFF8A24" Foreground="#FF111111" BorderThickness="0"/>
            <Button x:Name="saveButton" Content="Export JSON" Width="105" Padding="8,5" Margin="8,0,0,0" Click="saveButton_Click" IsEnabled="False"/>
            <TextBlock x:Name="statusText" Text="Not listening" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#FFBDBDBD"/>
        </DockPanel>
        <DataGrid x:Name="recordsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="#FF202020" Foreground="#FFF2F2F2" RowBackground="#FF252525"
                  AlternatingRowBackground="#FF2C2C2C" BorderBrush="#FF444444">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Game / Title ID" Binding="{Binding Game}" Width="1.3*"/>
                <DataGridTextColumn Header="Module" Binding="{Binding ModuleName}" Width="1.2*"/>
                <DataGridTextColumn Header="Process" Binding="{Binding ProcessId}" Width="70"/>
                <DataGridTextColumn Header="Module base" Binding="{Binding ModuleBase}" Width="1.2*"/>
                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="1.2*"/>
                <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="1.2*"/>
                <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFAAAAAA"
                   Text="Protocol: one UTF-8 JSON object per TCP line. Required fields: moduleName, moduleBase, address. Optional: gameTitle, titleId, gameVersion, processId, label. Offset is calculated as address - moduleBase; no memory is read by this Windows receiver."/>
    </Grid>
</Window>
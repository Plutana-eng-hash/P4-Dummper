<Window x:Class="PS4wpfDumper.PS4DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PS4 Console" Height="980" Width="1320" MinHeight="820" MinWidth="1080"
        WindowStartupLocation="CenterOwner" Background="#101010" Foreground="#F4F4F4"
        FontFamily="Segoe UI" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EDEDED"/></Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#F2F2F2"/><Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#F2F2F2"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#202020"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#505050"/><Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DADADA"/><Setter Property="Margin" Value="0,0,18,0"/>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="#171717"/><Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#383838"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="0.8*"/><RowDefinition Height="1.2*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="PS4 CONSOLE" FontSize="25" FontWeight="Bold"/>
                <TextBlock Text="FTP CONNECTION  /  DEVICE OVERVIEW" FontSize="10" Foreground="#929292" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="statusDot" Width="9" Height="9" Fill="#777777" Margin="0,0,8,0"/>
                <TextBlock x:Name="connectionLabel" Text="NOT CONNECTED" FontSize="11" FontWeight="Bold" Foreground="#CFCFCF" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="#191919" BorderBrush="#383838" BorderThickness="1" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="115"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="PS4 IP ADDRESS" FontSize="9" Foreground="#999999" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="hostTextBox" MinWidth="180" Height="34"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="FTP PORT" FontSize="9" Foreground="#999999" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="portTextBox" Height="34" Text="2121"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="connectButton" Content="Connect to PS4" Height="34" MinWidth="130" Click="ConnectButton_Click"/>
                    <Button x:Name="refreshButton" Content="Refresh scan" Height="34" MinWidth="105" Click="RefreshButton_Click" IsEnabled="False"/>
                    <Button x:Name="disconnectButton" Content="Disconnect" Height="34" MinWidth="95" Click="DisconnectButton_Click" IsEnabled="False" Background="#252525" Foreground="White" BorderBrush="#555555"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#191919" BorderBrush="#383838" BorderThickness="1" Padding="13" Margin="0,0,8,0"><StackPanel><TextBlock Text="LOCAL USERS" FontSize="9" Foreground="#999999" FontWeight="Bold"/><TextBlock x:Name="usersCount" Text="—" FontSize="27" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="IDs in /user/home" FontSize="10" Foreground="#999999"/></StackPanel></Border>
            <Border Grid.Column="1" Background="#191919" BorderBrush="#383838" BorderThickness="1" Padding="13" Margin="0,0,8,0"><StackPanel><TextBlock Text="GAME MOUNTS" FontSize="9" Foreground="#999999" FontWeight="Bold"/><TextBlock x:Name="mountsCount" Text="—" FontSize="27" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="Visible app / patch mounts" FontSize="10" Foreground="#999999"/></StackPanel></Border>
            <Border Grid.Column="2" Background="#191919" BorderBrush="#383838" BorderThickness="1" Padding="13" Margin="0,0,8,0"><StackPanel><TextBlock Text="APP METADATA" FontSize="9" Foreground="#999999" FontWeight="Bold"/><TextBlock x:Name="appsCount" Text="—" FontSize="27" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="Folders in /user/appmeta" FontSize="10" Foreground="#999999"/></StackPanel></Border>
            <Border Grid.Column="3" Background="#191919" BorderBrush="#383838" BorderThickness="1" Padding="13"><StackPanel><TextBlock Text="SYSTEM VERSION" FontSize="9" Foreground="#999999" FontWeight="Bold"/><TextBlock x:Name="versionValue" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="/etc/version when accessible" FontSize="10" Foreground="#999999"/></StackPanel></Border>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
            <GroupBox Header="CONSOLE &amp; NETWORK" Grid.Column="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="Connection details" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="networkInfo" Text="Enter your PS4 IP and FTP port, then connect." Foreground="#BDBDBD" TextWrapping="Wrap"/>
                    <Separator Background="#414141" Margin="0,13,0,13"/>
                    <TextBlock Text="Accessible root folders" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <ListView x:Name="rootList" Height="150"/>
                    <Separator Background="#414141" Margin="0,13,0,13"/>
                    <TextBlock Text="Scan options" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <CheckBox x:Name="scanAccountsCheckBox" Content="Local users" IsChecked="True"/>
                        <CheckBox x:Name="scanMountsCheckBox" Content="Game mounts" IsChecked="True"/>
                        <CheckBox x:Name="scanAppsCheckBox" Content="App metadata" IsChecked="True"/>
                        <CheckBox x:Name="readVersionCheckBox" Content="System version" IsChecked="True"/>
                    </WrapPanel>
                </StackPanel></ScrollViewer>
            </GroupBox>
            <GroupBox Header="LOCAL ACCOUNT DIRECTORIES" Grid.Column="1">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="These are local folder IDs, not confirmed PSN online IDs." Foreground="#AFAFAF" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <ListView x:Name="accountsList" Grid.Row="1"><ListView.View><GridView><GridViewColumn Header="LOCAL USER ID" DisplayMemberBinding="{Binding Id}" Width="160"/><GridViewColumn Header="PATH" DisplayMemberBinding="{Binding Source}" Width="125"/></GridView></ListView.View></ListView>
                </Grid>
            </GroupBox>
            <GroupBox Header="GAME MOUNTS &amp; APP DATA" Grid.Column="2" Margin="0,0,0,12">
                <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <ListView x:Name="mountsList" Grid.Row="0"/>
                    <TextBlock Grid.Row="1" Text="APP METADATA DIRECTORIES" FontSize="9" FontWeight="Bold" Foreground="#AFAFAF" Margin="0,10,0,7"/>
                    <ListView x:Name="appsList" Grid.Row="2"/>
                </Grid>
            </GroupBox>
        </Grid>
        <GroupBox Grid.Row="4" Header="PS4 FILE EXPLORER" Margin="0,0,0,10">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Grid.Row="0" Margin="0,0,0,8">
<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
<Button Content="Up" Click="FileUp_Click"/><Button Content="Refresh" Click="FileRefresh_Click"/><Button Content="Upload" Click="FileUpload_Click"/><Button Content="New folder" Click="FileNewFolder_Click"/><Button Content="Download" Click="FileDownload_Click"/><Button Content="Delete" Click="FileDelete_Click"/>
</StackPanel>
<TextBox x:Name="filePathBox" Text="/" Height="32" VerticalContentAlignment="Center"/><Button Content="Go" Click="FileGo_Click" MinWidth="50"/>
</DockPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
<ListView x:Name="remoteFilesList" MouseDoubleClick="RemoteFilesList_MouseDoubleClick" Margin="0,0,10,0"><ListView.View><GridView><GridViewColumn Header="NAME" DisplayMemberBinding="{Binding Name}" Width="240"/><GridViewColumn Header="TYPE" DisplayMemberBinding="{Binding TypeLabel}" Width="65"/><GridViewColumn Header="SIZE" DisplayMemberBinding="{Binding SizeLabel}" Width="85"/></GridView></ListView.View></ListView>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,6"><TextBlock Text="TEXT FILE EDITOR" Foreground="#AAAAAA" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Save changes" Click="FileSave_Click"/></DockPanel><TextBox x:Name="fileEditor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsEnabled="False" FontFamily="Consolas"/></Grid>
</Grid><TextBlock Grid.Row="2" x:Name="fileExplorerStatus" Text="Connect to browse files. Double-click folders to open; text files can be edited." Foreground="#AAAAAA" Margin="0,7,0,0"/>
</Grid></GroupBox>
<Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="statusLabel" Text="Ready. Connect to your PS4 to begin." Foreground="#AFAFAF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1" x:Name="exportButton" Content="Export report" Height="32" MinWidth="110" Click="ExportButton_Click" IsEnabled="False" Background="#252525" Foreground="White" BorderBrush="#555555"/>
            <Button Grid.Column="2" Content="Open Dumper" Height="32" MinWidth="115" Click="OpenDumperButton_Click" Background="#F2F2F2" Foreground="#111111" BorderBrush="#F2F2F2"/>
            <Button Grid.Column="3" Content="Close" Height="32" MinWidth="80" Click="CloseButton_Click" Background="#252525" Foreground="White" BorderBrush="#555555"/>
        </Grid>
    </Grid>
</Window>
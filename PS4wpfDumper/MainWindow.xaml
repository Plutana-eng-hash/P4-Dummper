<Window x:Name="PS4_Dumper" x:Class="PS4wpfDumper.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:local="clr-namespace:PS4wpfDumper" mc:Ignorable="d"
 Title="Plutana-DMP | PS4 Dumper" Width="1420" Height="900" MinWidth="1080" MinHeight="700"
 WindowStartupLocation="CenterScreen" Background="#FF000000" Foreground="#FFFFFFFF" Icon="libs/BigMac.ico">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFFFFFFF"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Label"><Setter Property="Foreground" Value="#FFFFFFFF"/><Setter Property="Padding" Value="2"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#FFFFFFFF"/><Setter Property="Foreground" Value="#FF000000"/><Setter Property="BorderBrush" Value="#FFFFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,7"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="3"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#FF101010"/><Setter Property="Foreground" Value="#FFFFFFFF"/><Setter Property="CaretBrush" Value="#FFFFFFFF"/><Setter Property="BorderBrush" Value="#FFAAAAAA"/><Setter Property="Padding" Value="7,5"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#FF080808"/><Setter Property="Foreground" Value="#FFFFFFFF"/><Setter Property="BorderBrush" Value="#FF888888"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#FF101010"/><Setter Property="Foreground" Value="#FFFFFFFF"/><Setter Property="BorderBrush" Value="#FFAAAAAA"/><Setter Property="Padding" Value="5"/></Style>
  <Style TargetType="GroupBox"><Setter Property="Foreground" Value="#FFFFFFFF"/><Setter Property="BorderBrush" Value="#FF888888"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,0,10,10"/></Style>
  <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#FFFFFFFF"/><Setter Property="Margin" Value="0,0,16,0"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#FFFFFFFF"/><Setter Property="Margin" Value="0,0,12,0"/></Style>
  <Style TargetType="TabItem"><Setter Property="Background" Value="#FF111111"/><Setter Property="Foreground" Value="#FFFFFFFF"/><Setter Property="Padding" Value="22,11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="BorderBrush" Value="#FF888888"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FFFFFFFF"/><Setter Property="Foreground" Value="#FF000000"/></Trigger></Style.Triggers></Style>
  <Style TargetType="GroupBox"><Setter Property="Foreground" Value="#FFFFFFFF"/><Setter Property="BorderBrush" Value="#FF888888"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,0,10,10"/></Style>
 </Window.Resources>
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="2,0,2,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="PLUTANA-DMP" FontSize="23" FontWeight="Bold"/><TextBlock Text="PS4 GAME DUMPER  •  PAYLOAD SENDER  •  CONSOLE FILES" Foreground="#FFE0E0E0" FontSize="11" Margin="0,3,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ps4DashboardButton" Content="Console &amp; Files" Width="130" Height="34" Click="ps4DashboardButton_Click"/><Button x:Name="runtimeInspectorButton" Content="Runtime Inspector" Width="140" Height="34" Click="runtimeInspectorButton_Click"/></StackPanel>
  </Grid>
  <TabControl x:Name="mainTabs" Grid.Row="1" Background="#FF000000" BorderBrush="#FF888888">
   <TabItem Header="GAME DUMPER &amp; PAYLOAD">
    <Grid Margin="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="0.88*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <GroupBox Header="DETECTED GAME MOUNTS" Grid.Column="0">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <DockPanel Grid.Row="0" Margin="0,0,0,8"><TextBlock x:Name="listingStatusLabel" Text="Connect to your PS4 to detect mounted games" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock DockPanel.Dock="Right" Text="RIGHT-CLICK A GAME FOR ACTIONS" Foreground="#FFDDDDDD" FontSize="10" VerticalAlignment="Center"/></DockPanel>
       <WrapPanel Grid.Row="1" Margin="0,0,0,8">
        <RadioButton x:Name="baseRadioButton" Content="Base Game" IsChecked="True" Checked="baseRadioButton_Checked"/>
        <RadioButton x:Name="patchRadioButton" Content="Game Patch" Checked="patchRadioButton_Checked"/>
        <RadioButton x:Name="acRadioButton" Content="Loaded DLC" IsEnabled="False" Checked="acRadioButton_Checked"/>
        <RadioButton x:Name="allRadioButton" Content="All" Checked="allRadioButton_Checked"/>
       </WrapPanel>
       <ListBox x:Name="outputListBox" Grid.Row="2" SelectionChanged="outputListBox_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="5">
        <ListBox.ItemContainerStyle><Style TargetType="{x:Type ListBoxItem}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="BorderThickness" Value="0"/><EventSetter Event="PreviewMouseRightButtonDown" Handler="MountItem_PreviewMouseRightButtonDown"/><Setter Property="ContextMenu"><Setter.Value><ContextMenu><MenuItem Header="Dump this mount"/><Separator/><MenuItem Header="Copy title ID"/><MenuItem Header="Open local dump folder"/><MenuItem Header="Copy mount path"/></ContextMenu></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><Border Padding="9" Background="#FF171717" BorderBrush="#FF777777" BorderThickness="1" CornerRadius="3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="48" Height="48" Background="#FF050505" BorderBrush="#FF777777" BorderThickness="1" VerticalAlignment="Center"><Image Source="{Binding Icon}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,5,0"><TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFFFF"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#FFE0E0E0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding MountType}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </Grid>
     </GroupBox>
     <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <GroupBox Header="PS4 CONNECTION" Grid.Row="0">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CONSOLE IP" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/><TextBox x:Name="ipTextBox" Text="10.0.0.6" Height="32" TextChanged="ipTextBox_TextChanged"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="FTP PORT" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/><TextBox x:Name="portTextBox" Text="2121" Height="32" TextChanged="portTextBox_TextChanged"/></StackPanel><Button x:Name="button1" Grid.Column="2" Content="Connect" Width="92" Height="32" VerticalAlignment="Bottom" Click="button1_Click"/></Grid>
      </GroupBox>
      <GroupBox Header="DUMP OPTIONS" Grid.Row="1">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="OUTPUT FORMAT" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/><ComboBox x:Name="formatComboBox" Height="32" MinWidth="190"/><CheckBox x:Name="checkBox" Content="Build FPKG package" Visibility="Collapsed"/></StackPanel><Button x:Name="button" Grid.Column="1" Content="START DUMP" Width="140" Height="42" VerticalAlignment="Bottom" Click="button_Click_1"/></Grid>
      </GroupBox>
      <GroupBox Header="SELECTED GAME DETAILS" Grid.Row="2" Margin="0">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image x:Name="image" Width="112" Height="112" Stretch="Uniform" Margin="0,0,12,8"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="gameLabel" FontSize="16" FontWeight="Bold"/><TextBlock x:Name="cusaLabel" Margin="0,4,0,0"/><TextBlock x:Name="cidLabel" Margin="0,3,0,0"/><TextBlock x:Name="appVerLabel" Margin="0,3,0,0"/><TextBlock x:Name="verLabel" Margin="0,3,0,0"/></StackPanel></Grid>
        <Separator Background="#FF777777" Margin="0,7"/>
        <Expander Header="SFO / PACKAGE METADATA" Foreground="White" IsExpanded="False"><StackPanel><Label x:Name="sfoTITLELabel" Content="TITLE"/><Label x:Name="APP_VERLabel" Content="APP_VER"/><Label x:Name="ATTRIBUTELabel" Content="ATTRIBUTE"/><Label x:Name="ATTRIBUTE2Label" Content="ATTRIBUTE2"/><Label x:Name="CATEGORYLabel" Content="CONTENT_ID"/><Label x:Name="PUBTOOLINFOcLabel" Content="PUBTOOLINFO c_date:"/><Label x:Name="PUBTOOLINFOsdkLabel" Content="PUBTOOLINFO sdk_ver:"/><Label x:Name="PUBTOOLINFOstLabel" Content="PUBTOOLINFO st_type:"/><Label x:Name="PUBTOOLINFOl0Label" Content="PUBTOOLINFO img0_l0_size:"/><Label x:Name="PUBTOOLINFOl1Label" Content="PUBTOOLINFO img0_l1_size:"/><Label x:Name="PUBTOOLINFOscLabel" Content="PUBTOOLINFO img0_sc_ksize:"/><Label x:Name="PUBTOOLINFOpcLabel" Content="PUBTOOLINFO img0_pc_ksize:"/><Label x:Name="VERSIONsLabel" Content="VERSION:"/></StackPanel></Expander>
        <Label x:Name="keystoneLabel" Content=""/><Label x:Name="npLabel" Content=""/><Label x:Name="codeLabel" Content=""/>
       </StackPanel></ScrollViewer>
      </GroupBox>
     </Grid>
     <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#FF101010" BorderBrush="#FF777777" BorderThickness="1" CornerRadius="4" Padding="9" Margin="0,8,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DUMP / PAYLOAD ACTIVITY" FontWeight="Bold" FontSize="10"/><TextBlock x:Name="loadingLabel" Text="Ready — connect, select a mount, then start a dump." Margin="0,3,0,0"/><TextBlock x:Name="prcnt" Margin="0,3,0,0" Foreground="#FFE0E0E0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><CheckBox x:Name="sendPayloadCheckBox" Content="Send Payload" Checked="MyCheckBox_Checked" Unchecked="MyCheckBox_Unchecked" VerticalAlignment="Center"/><ComboBox x:Name="comboBox" Width="190" Height="32" Margin="5,0"/><Button Content="SEND / CONNECT" x:Name="payloadActionButton" Width="145" Height="34" Click="button1_Click"/></StackPanel></Grid>
     </Border>
     <Button x:Name="button2" Content="Check SFO" Visibility="Collapsed" Click="button2_Click"/><Button x:Name="button3" Content="Button" Visibility="Collapsed" Click="button3_Click"/><Label x:Name="label" Content="PS4 Port:" Visibility="Collapsed"/><Label x:Name="ipLabel" Content="PS4 IP Address:" Visibility="Collapsed"/>
    </Grid>
   </TabItem>
   <TabItem Header="CONSOLE &amp; FILE TRANSFER"><local:PS4DashboardWindow x:Name="dashboardControl"/></TabItem>
  </TabControl>
  <TextBlock Grid.Row="2" Text="BLACK &amp; WHITE INTERFACE  •  ONE WINDOW  •  DUMPER AND PAYLOAD SENDER ARE SEPARATE FUNCTIONS" Foreground="#FFCCCCCC" FontSize="10" Margin="3,9,0,0"/>
 </Grid>
</Window>
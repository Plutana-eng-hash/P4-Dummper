<Window x:Class="PS4wpfDumper.PS4DashboardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PS4 Console Dashboard" Height="650" Width="900" MinHeight="560" MinWidth="760" WindowStartupLocation="CenterOwner" Background="#F3F5F8">
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Grid.Row="0" Margin="0,0,0,14"><StackPanel><TextBlock Text="PS4 CONSOLE DASHBOARD" FontSize="21" FontWeight="Bold" Foreground="#172033"/><TextBlock x:Name="connectionLabel" Text="Not connected" Foreground="#657184" Margin="0,4,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="refreshButton" Content="Refresh" Width="92" Height="32" Margin="0,0,8,0" Click="RefreshButton_Click"/><Button x:Name="exportButton" Content="Export report" Width="110" Height="32" Click="ExportButton_Click"/></StackPanel></DockPanel>
<UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
<Border Background="White" CornerRadius="7" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="LOCAL USERS" FontSize="10" FontWeight="Bold" Foreground="#718096"/><TextBlock x:Name="usersCount" Text="—" FontSize="24" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="Home directories" FontSize="10" Foreground="#718096"/></StackPanel></Border>
<Border Background="White" CornerRadius="7" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="GAME MOUNTS" FontSize="10" FontWeight="Bold" Foreground="#718096"/><TextBlock x:Name="mountsCount" Text="—" FontSize="24" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="Visible mount folders" FontSize="10" Foreground="#718096"/></StackPanel></Border>
<Border Background="White" CornerRadius="7" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="APP METADATA" FontSize="10" FontWeight="Bold" Foreground="#718096"/><TextBlock x:Name="appsCount" Text="—" FontSize="24" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="App metadata folders" FontSize="10" Foreground="#718096"/></StackPanel></Border>
<Border Background="White" CornerRadius="7" Padding="12"><StackPanel><TextBlock Text="FTP STATUS" FontSize="10" FontWeight="Bold" Foreground="#718096"/><TextBlock x:Name="ftpStatus" Text="Offline" FontSize="24" FontWeight="SemiBold" Foreground="#B54747"/><TextBlock Text="Read-only scan" FontSize="10" Foreground="#718096"/></StackPanel></Border>
</UniformGrid>
<TabControl Grid.Row="2" Background="White"><TabItem Header="Overview"><Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="Console information" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock x:Name="consoleInfo" Text="Connecting..." TextWrapping="Wrap" Foreground="#354052"/><Separator Margin="0,14,0,14"/><TextBlock Text="Network / connection" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock x:Name="networkInfo" TextWrapping="Wrap" Foreground="#354052"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Scan results" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock x:Name="scanInfo" TextWrapping="Wrap" Foreground="#354052"/><Separator Margin="0,14,0,14"/><TextBlock Text="Privacy note" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="FTP exposes local user directory IDs, not necessarily PSN online IDs or account names. Passwords, tokens, saved credentials, and private account files are not read or exported." TextWrapping="Wrap" Foreground="#657184"/></StackPanel></Grid></TabItem>
<TabItem Header="Local accounts"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Local user directory IDs discovered under /user/home. These are console-local IDs, not verified PSN online IDs or profile names." TextWrapping="Wrap" Foreground="#657184" Margin="0,0,0,10"/><ListView x:Name="accountsList" Grid.Row="1"><ListView.View><GridView><GridViewColumn Header="Local user ID" DisplayMemberBinding="{Binding Id}" Width="220"/><GridViewColumn Header="Source" DisplayMemberBinding="{Binding Source}" Width="180"/></GridView></ListView.View></ListView></Grid></TabItem>
<TabItem Header="Options"><StackPanel Margin="16"><TextBlock Text="Read-only scan options" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/><CheckBox x:Name="scanAccountsCheckBox" Content="Scan local user directory IDs" IsChecked="True" Margin="0,4"/><CheckBox x:Name="scanMountsCheckBox" Content="Count mounted game directories" IsChecked="True" Margin="0,4"/><CheckBox x:Name="scanAppsCheckBox" Content="Count app metadata directories" IsChecked="True" Margin="0,4"/><CheckBox x:Name="readVersionCheckBox" Content="Read /etc/version if accessible" IsChecked="True" Margin="0,4"/><TextBlock Text="No account files, saves, licenses, or console settings are modified." TextWrapping="Wrap" Foreground="#657184" Margin="0,14,0,0"/></StackPanel></TabItem></TabControl>
<TextBlock x:Name="statusLabel" Grid.Row="3" Text="Ready" Foreground="#657184" Margin="0,12,0,0"/></Grid></Window>
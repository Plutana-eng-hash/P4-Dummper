<Window x:Class="PS4wpfDumper.PS4DashboardWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PS4 Console Dashboard" Height="900" Width="1280" MinHeight="700" MinWidth="980" WindowStartupLocation="CenterOwner"
 Background="#000000" Foreground="#FFFFFF" FontFamily="Segoe UI" Closing="Window_Closing">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFFFFF"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#000000"/><Setter Property="BorderBrush" Value="#FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,7"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="4,0,0,0"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#111111"/><Setter Property="Foreground" Value="#F4F6FA"/><Setter Property="BorderBrush" Value="#777777"/><Setter Property="Padding" Value="8,6"/><Setter Property="CaretBrush" Value="White"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Margin" Value="0,0,16,8"/></Style>
  <Style TargetType="ListView"><Setter Property="Background" Value="#111111"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#777777"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="GroupBox"><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#777777"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,0,10,10"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Background" Value="#111111"/><Setter Property="Padding" Value="22,11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="BorderBrush" Value="#777777"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#000000"/><Setter Property="BorderBrush" Value="#FFFFFF"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ListViewItem"><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Background" Value="#111111"/><Setter Property="Padding" Value="4,5"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#000000"/></Trigger></Style.Triggers></Style>
  <Style TargetType="GridViewColumnHeader"><Setter Property="Foreground" Value="#000000"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="6,7"/></Style>
 </Window.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,13">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="PS4 CONTROL CENTER" FontSize="24" FontWeight="Bold"/><TextBlock Text="CONSOLE DASHBOARD  /  TRANSFER  /  PAYLOAD TOOLS" FontSize="12" Foreground="#E0E0E0" Margin="0,3,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="statusDot" Width="9" Height="9" Fill="#FFFFFF" Margin="0,0,8,0"/><TextBlock x:Name="connectionLabel" Text="NOT CONNECTED" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="#111111" BorderBrush="#777777" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,10">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,10,0"><TextBlock Text="PS4 HOST / IP" FontSize="11" Foreground="#E0E0E0" FontWeight="Bold" Margin="0,0,0,4"/><TextBox x:Name="hostTextBox" MinWidth="180" Height="34"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="FTP PORT" FontSize="9" Foreground="#E0E0E0" FontWeight="Bold" Margin="0,0,0,4"/><TextBox x:Name="portTextBox" Height="34" Text="2121"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom"><Button x:Name="connectButton" Content="Connect" Height="34" MinWidth="100" Click="ConnectButton_Click"/><Button x:Name="refreshButton" Content="Refresh scan" Height="34" Click="RefreshButton_Click" IsEnabled="False"/><Button x:Name="disconnectButton" Content="Disconnect" Height="34" Click="DisconnectButton_Click" IsEnabled="False" Background="#222222" BorderBrush="#888888"/></StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="2" Background="#080808" BorderBrush="#777777" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,0,0,10">
   <DockPanel><TextBlock Text="ACTIVITY" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock x:Name="activityLabel" Text="Ready — connect to your PS4 to begin." Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel>
  </Border>
  <TabControl Grid.Row="3" Background="#000000" BorderBrush="#777777">
   <TabItem Header="Overview &amp; Activity">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="#111111" BorderBrush="#777777" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="LOCAL USERS" FontSize="9" Foreground="#E0E0E0" FontWeight="Bold"/><TextBlock x:Name="usersCount" Text="—" FontSize="27" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="/user/home" FontSize="10" Foreground="#E0E0E0"/></StackPanel></Border>
      <Border Grid.Column="1" Background="#111111" BorderBrush="#777777" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="GAME MOUNTS" FontSize="9" Foreground="#E0E0E0" FontWeight="Bold"/><TextBlock x:Name="mountsCount" Text="—" FontSize="27" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="App / patch mounts" FontSize="10" Foreground="#E0E0E0"/></StackPanel></Border>
      <Border Grid.Column="2" Background="#111111" BorderBrush="#777777" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="APP METADATA" FontSize="9" Foreground="#E0E0E0" FontWeight="Bold"/><TextBlock x:Name="appsCount" Text="—" FontSize="27" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="/user/appmeta" FontSize="10" Foreground="#E0E0E0"/></StackPanel></Border>
      <Border Grid.Column="3" Background="#111111" BorderBrush="#777777" BorderThickness="1" CornerRadius="5" Padding="12"><StackPanel><TextBlock Text="SYSTEM VERSION" FontSize="9" Foreground="#E0E0E0" FontWeight="Bold"/><TextBlock x:Name="versionValue" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="/etc/version" FontSize="10" Foreground="#E0E0E0"/></StackPanel></Border>
     </Grid>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
      <GroupBox Header="CONSOLE &amp; NETWORK"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Connection details" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock x:Name="networkInfo" Text="Enter your PS4 IP and FTP port, then connect." Foreground="#E6E6E6" TextWrapping="Wrap"/><Separator Background="#777777" Margin="0,13"/><TextBlock Text="Accessible root folders" FontWeight="SemiBold" Margin="0,0,0,7"/><ListView x:Name="rootList" Height="145"/><Separator Background="#777777" Margin="0,13"/><TextBlock Text="Scan options" FontWeight="SemiBold" Margin="0,0,0,8"/><WrapPanel><CheckBox x:Name="scanAccountsCheckBox" Content="Local users" IsChecked="True"/><CheckBox x:Name="scanMountsCheckBox" Content="Game mounts" IsChecked="True"/><CheckBox x:Name="scanAppsCheckBox" Content="App metadata" IsChecked="True"/><CheckBox x:Name="readVersionCheckBox" Content="System version" IsChecked="True"/></WrapPanel></StackPanel></ScrollViewer></GroupBox>
      <GroupBox Header="LOCAL ACCOUNT DIRECTORIES" Grid.Column="1"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Local folder IDs — not confirmed PSN online IDs." Foreground="#E0E0E0" TextWrapping="Wrap" Margin="0,0,0,8"/><ListView x:Name="accountsList" Grid.Row="1"><ListView.View><GridView><GridViewColumn Header="LOCAL USER ID" DisplayMemberBinding="{Binding Id}" Width="150"/><GridViewColumn Header="PATH" DisplayMemberBinding="{Binding Source}" Width="110"/></GridView></ListView.View></ListView></Grid></GroupBox>
      <GroupBox Header="GAME MOUNTS &amp; APP DATA" Grid.Column="2" Margin="0,0,0,10"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><ListView x:Name="mountsList"/><TextBlock Grid.Row="1" Text="APP METADATA DIRECTORIES" FontSize="9" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,9,0,6"/><ListView x:Name="appsList" Grid.Row="2"/></Grid></GroupBox>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="File Transfer">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Margin="0,0,0,10"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Up" Click="FileUp_Click"/><Button Content="Refresh" Click="FileRefresh_Click"/><Button Content="Upload files" Click="FileUpload_Click"/><Button Content="New folder" Click="FileNewFolder_Click"/><Button Content="Download" Click="FileDownload_Click"/><Button Content="Delete" Click="FileDelete_Click" Background="#222222" BorderBrush="#FFFFFF"/></StackPanel><TextBox x:Name="filePathBox" Text="/" Height="34" VerticalContentAlignment="Center"/><Button Content="Open path" Click="FileGo_Click" MinWidth="82"/></DockPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
      <GroupBox Header="REMOTE FILES &amp; FOLDERS"><ListView x:Name="remoteFilesList" MouseDoubleClick="RemoteFilesList_MouseDoubleClick"><ListView.View><GridView><GridViewColumn Header="NAME" DisplayMemberBinding="{Binding Name}" Width="250"/><GridViewColumn Header="TYPE" DisplayMemberBinding="{Binding TypeLabel}" Width="70"/><GridViewColumn Header="SIZE" DisplayMemberBinding="{Binding SizeLabel}" Width="100"/></GridView></ListView.View></ListView></GroupBox>
      <GroupBox Grid.Column="1" Header="TEXT FILE EDITOR" Margin="0,0,0,10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,7"><TextBlock Text="Text files up to 2 MB • binary files use Download" Foreground="#E0E0E0" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Save to PS4" Click="FileSave_Click"/></DockPanel><TextBox x:Name="fileEditor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsEnabled="False" FontFamily="Consolas"/></Grid></GroupBox>
     </Grid><TextBlock Grid.Row="2" x:Name="fileExplorerStatus" Text="Connect first. Double-click folders to browse and text files to edit." Foreground="#E0E0E0" Margin="0,8,0,0"/>
    </Grid>
   </TabItem>
   <TabItem Header="Console Explorer">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="PS4 directory browser" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBlock Grid.Row="1" Text="Use the File Transfer tab to browse, upload, download, create folders, delete items, and edit supported text files. Console scans and discovered paths are shown on Overview &amp; Activity." Foreground="#E6E6E6" TextWrapping="Wrap" VerticalAlignment="Top"/></Grid>
   </TabItem>
   <TabItem Header="Payload Loader &amp; Tools">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="Payload loader &amp; PS4 utilities" FontSize="21" FontWeight="SemiBold"/>
     <TextBlock Grid.Row="1" Text="The existing Dumper window contains the payload selection / Send Payload controls, mount detection, dump workflow, and payload integrations. Open it below to keep using those existing features." Foreground="#B8C2D2" TextWrapping="Wrap" Margin="0,8,0,16"/>
     <WrapPanel Grid.Row="2"><Button Content="Open PS4 Dumper + Payload Loader" Height="42" MinWidth="260" Click="OpenDumperButton_Click"/><Button Content="Export console report" Height="42" MinWidth="160" Click="ExportButton_Click" x:Name="exportButton" IsEnabled="False" Background="#222222" BorderBrush="#888888"/></WrapPanel>
     <Border Grid.Row="3" Background="#111111" BorderBrush="#777777" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,18,0,0"><StackPanel><TextBlock Text="Included build outputs" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="• PS4Dumper Windows x64 application&#10;• Goto Home.bin one-shot payload&#10;• TrampWare GoldHEN plugin (PRX / SPRX package copies)" Foreground="#B8C2D2" TextWrapping="Wrap"/><TextBlock Text="Payload sending still runs through the existing Dumper workflow. Payload compatibility depends on the console firmware, exploit state, and payload requirements." Foreground="#E0E0E0" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
    </Grid>
   </TabItem>
  </TabControl>
  <Grid Grid.Row="4" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="statusLabel" Text="Ready. Connect to your PS4 to begin." Foreground="#E0E0E0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Content="Export report" Height="32" MinWidth="110" Click="ExportButton_Click" IsEnabled="False" Background="#222222" BorderBrush="#888888"/><Button Grid.Column="2" Content="Close" Height="32" MinWidth="80" Click="CloseButton_Click" Background="#222222" BorderBrush="#888888"/></Grid>
 </Grid>
</Window>
<UserControl x:Class="PS4wpfDumper.PS4DashboardWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 Background="#FF000000" Foreground="#FFFFFFFF" FontFamily="Segoe UI">
 <UserControl.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFFFFFFF"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#FFFFFFFF"/><Setter Property="Foreground" Value="#FF000000"/><Setter Property="BorderBrush" Value="#FFFFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,7"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="3"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#FF101010"/><Setter Property="Foreground" Value="#FFFFFFFF"/><Setter Property="BorderBrush" Value="#FFAAAAAA"/><Setter Property="Padding" Value="7,5"/><Setter Property="CaretBrush" Value="White"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#FFFFFFFF"/><Setter Property="Margin" Value="0,0,12,7"/></Style>
  <Style TargetType="ListView"><Setter Property="Background" Value="#FF080808"/><Setter Property="Foreground" Value="#FFFFFFFF"/><Setter Property="BorderBrush" Value="#FF888888"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="GroupBox"><Setter Property="Foreground" Value="#FFFFFFFF"/><Setter Property="BorderBrush" Value="#FF888888"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,0,9,9"/></Style>
  <Style TargetType="ListViewItem"><Setter Property="Foreground" Value="#FFFFFFFF"/><Setter Property="Background" Value="#FF101010"/><Setter Property="Padding" Value="5"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FFFFFFFF"/><Setter Property="Foreground" Value="#FF000000"/></Trigger></Style.Triggers></Style>
  <Style TargetType="GridViewColumnHeader"><Setter Property="Foreground" Value="#FF000000"/><Setter Property="Background" Value="#FFFFFFFF"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="6,6"/></Style>
 </UserControl.Resources>
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CONSOLE &amp; FILE TRANSFER" FontSize="20" FontWeight="Bold"/><TextBlock Text="Connect once, scan console folders, and manage remote files from this screen." Foreground="#FFE0E0E0" FontSize="11" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="statusDot" Width="10" Height="10" Fill="#FFFFFFFF" Margin="0,0,7,0"/><TextBlock x:Name="connectionLabel" Text="NOT CONNECTED" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></Grid>
  <Border Grid.Row="1" Background="#FF101010" BorderBrush="#FF888888" BorderThickness="1" CornerRadius="4" Padding="9" Margin="0,0,0,9">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="PS4 IP / HOST" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/><TextBox x:Name="hostTextBox" Height="32"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="FTP PORT" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/><TextBox x:Name="portTextBox" Height="32" Text="2121"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom"><Button x:Name="connectButton" Content="Connect" Height="32" MinWidth="90" Click="ConnectButton_Click"/><Button x:Name="refreshButton" Content="Refresh" Height="32" Click="RefreshButton_Click" IsEnabled="False"/><Button x:Name="disconnectButton" Content="Disconnect" Height="32" Click="DisconnectButton_Click" IsEnabled="False"/></StackPanel></Grid>
  </Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
   <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <GroupBox Header="CONSOLE SUMMARY &amp; SCAN OPTIONS"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="USERS" FontSize="9" FontWeight="Bold" Foreground="#FFE0E0E0"/><TextBlock x:Name="usersCount" Text="—" FontSize="23" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="MOUNTS" FontSize="9" FontWeight="Bold" Foreground="#FFE0E0E0"/><TextBlock x:Name="mountsCount" Text="—" FontSize="23" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="APPS" FontSize="9" FontWeight="Bold" Foreground="#FFE0E0E0"/><TextBlock x:Name="appsCount" Text="—" FontSize="23" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="SYSTEM" FontSize="9" FontWeight="Bold" Foreground="#FFE0E0E0"/><TextBlock x:Name="versionValue" Text="—" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/></StackPanel><WrapPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,8,0,0"><CheckBox x:Name="scanAccountsCheckBox" Content="Users" IsChecked="True"/><CheckBox x:Name="scanMountsCheckBox" Content="Mounts" IsChecked="True"/><CheckBox x:Name="scanAppsCheckBox" Content="Apps" IsChecked="True"/><CheckBox x:Name="readVersionCheckBox" Content="Version" IsChecked="True"/></WrapPanel></Grid></GroupBox>
    <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><GroupBox Header="ROOT FOLDERS"><ListView x:Name="rootList"/></GroupBox><GroupBox Grid.Row="1" Header="LOCAL USER DIRECTORIES"><ListView x:Name="accountsList"><ListView.View><GridView><GridViewColumn Header="USER ID" DisplayMemberBinding="{Binding Id}" Width="130"/><GridViewColumn Header="PATH" DisplayMemberBinding="{Binding Source}" Width="125"/></GridView></ListView.View></ListView></GroupBox><GroupBox Grid.Row="2" Header="GAME MOUNTS &amp; APP METADATA"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MOUNTS" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/><ListView x:Name="mountsList" Height="105"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="APP METADATA" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/><ListView x:Name="appsList" Height="105"/></StackPanel></Grid></GroupBox></Grid>
    <TextBlock Grid.Row="2" x:Name="networkInfo" Text="Enter the PS4 IP and FTP port, then connect." Foreground="#FFE0E0E0" TextWrapping="Wrap" Margin="2,0,4,4"/>
   </Grid>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <GroupBox Header="REMOTE FILES"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,7"><TextBox x:Name="filePathBox" Text="/" Height="32" VerticalContentAlignment="Center"/><Button Content="Open" Click="FileGo_Click" MinWidth="65"/><Button Content="Up" Click="FileUp_Click" MinWidth="50"/></DockPanel><ListView x:Name="remoteFilesList" Grid.Row="1" MouseDoubleClick="RemoteFilesList_MouseDoubleClick"><ListView.View><GridView><GridViewColumn Header="NAME" DisplayMemberBinding="{Binding Name}" Width="230"/><GridViewColumn Header="TYPE" DisplayMemberBinding="{Binding TypeLabel}" Width="65"/><GridViewColumn Header="SIZE" DisplayMemberBinding="{Binding SizeLabel}" Width="90"/></GridView></ListView.View></ListView></Grid></GroupBox>
    <GroupBox Grid.Row="1" Header="FILE ACTIONS"><WrapPanel><Button Content="Refresh list" Click="FileRefresh_Click"/><Button Content="Upload files" Click="FileUpload_Click"/><Button Content="Download selected" Click="FileDownload_Click"/><Button Content="New folder" Click="FileNewFolder_Click"/><Button Content="Delete selected" Click="FileDelete_Click"/></WrapPanel><TextBlock Text="Double-click a folder to open it, or a text file to load it in the editor below." Foreground="#FFE0E0E0" FontSize="11" Margin="4,5,4,0"/></GroupBox>
    <GroupBox Grid.Row="2" Header="TEXT FILE EDITOR"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,6"><TextBlock Text="Text files up to 2 MB • binary files: Download" Foreground="#FFE0E0E0" FontSize="10" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Save to PS4" Click="FileSave_Click"/></DockPanel><TextBox x:Name="fileEditor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsEnabled="False" FontFamily="Consolas"/></Grid></GroupBox>
   </Grid>
  </Grid>
  <Grid Grid.Row="3" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="fileExplorerStatus" Text="Connect first. Select a remote item to use the file actions." Foreground="#FFFFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="exportButton" Content="Export console report" Click="ExportButton_Click" IsEnabled="False"/><Button Content="Export report" Click="ExportButton_Click" IsEnabled="False" Visibility="Collapsed"/></StackPanel><TextBlock x:Name="activityLabel" Text="Ready — connect to your PS4 to begin." Visibility="Collapsed"/></Grid>
  <TextBlock x:Name="statusLabel" Text="Ready. Connect to your PS4 to begin." Foreground="#FFE0E0E0" Visibility="Collapsed"/>
 </Grid>
</UserControl>